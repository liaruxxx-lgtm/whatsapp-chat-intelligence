# Keep this file non-sensitive. Create .env locally and never commit it.
# Optional; leave blank to use ~/Library/Application Support/WhatsAppChatIntelligence.
WCI_DATA_DIR=
WCI_TIMEZONE=Europe/Berlin
WCI_LOCALE=de
WCI_REMINDER_LEAD_MINUTES=30
WCI_LIVE_IMPORT_ENABLED=false
WCI_EXTERNAL_TRANSCRIPTION_ENABLED=false
WCI_KILL_SWITCH=false
# Optional. A chat is sent to OpenAI only after a dashboard confirmation.
WCI_OPENAI_SUMMARIES_ENABLED=false
WCI_OPENAI_API_KEY=
WCI_OPENAI_SUMMARY_MODEL=gpt-6-astra
# Generate locally: openssl rand -base64 32
WCI_ENCRYPTION_KEY_BASE64=
# Required for an explicitly chosen live adapter or local chat-export import.
WCI_ACCOUNT_AUTHORIZED=false
WCI_RETENTION_DAYS=30
# Reject raw audio larger than this before it reaches the local vault/runner.
WCI_MAX_MEDIA_BYTES=67108864
# Set each to true only after reviewing the visible local setup checklist.
WCI_TIMEZONE_CONFIRMED=false
WCI_RETENTION_CONFIRMED=false
WCI_EXPORT_DELETION_CONFIRMED=false
WCI_NOTIFICATIONS_CONFIRMED=false
WCI_SETUP_CONFIRMED=false
# Optional offline chat-export import only. These values do not enable live ingest.
# The target chat must already be in the explicit allowlist; use an absolute .txt path.
WCI_CONFIRM_CHAT_EXPORT_IMPORT=false
WCI_CHAT_EXPORT_PATH=
WCI_CHAT_EXPORT_CHAT_ID=
WCI_CHAT_EXPORT_SELF_SENDER=
# `auto` rejects ambiguous numeric slash/hyphen dates; choose dmy or mdy only knowingly.
WCI_CHAT_EXPORT_DATE_ORDER=auto
